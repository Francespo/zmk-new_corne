#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#define DEFAULT           0
#define SYMBOLS           1
#define NUMPAD_LH         2
#define NAV               3
#define ACCENTS           4
#define SHORTCUTS_F       5
#define SHORTCUTS_MEH     6
#define GAMING            7
#define GAMING_NUMBERS    8
#define MEDIA_SYS         9
#define FUNCTION_SYSTEM   10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    macros {
        usi_a_grv: usi_a_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp A>;
        };

        usi_e_grv: usi_e_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp E>;
        };

        usi_e_acu: usi_e_acu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp E>;
        };

        usi_i_grv: usi_i_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp I>;
        };

        usi_o_grv: usi_o_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp O>;
        };

        usi_u_grv: usi_u_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp U>;
        };

        usi_quote: usi_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SPACE>;
            label = "USI_QUOTE";
        };

        usi_dquote: usi_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp SPACE>;
            label = "USI_DQTE";
        };

        usi_grave: usi_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "USI_GRAVE";
        };

        usi_tilde: usi_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp SPACE>;
            label = "USI_TILDE";
        };

        usi_caret: usi_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp SPACE>;
            label = "USI_CARET";
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
            label = "LSHIFT/CAPS Tap Dance";
        };

        // Tap-Dance F1..F12 (1 tap) e F13..F24 (2 tap)
        td_f1: td_f1 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F1>, <&kp F13>; };
        td_f2: td_f2 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F2>, <&kp F14>; };
        td_f3: td_f3 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F3>, <&kp F15>; };
        td_f4: td_f4 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F4>, <&kp F16>; };
        td_f5: td_f5 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F5>, <&kp F17>; };
        td_f6: td_f6 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F6>, <&kp F18>; };
        td_f7: td_f7 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F7>, <&kp F19>; };
        td_f8: td_f8 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F8>, <&kp F20>; };
        td_f9: td_f9 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F9>, <&kp F21>; };
        td_f10: td_f10 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F10>, <&kp F22>; };
        td_f11: td_f11 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F11>, <&kp F23>; };
        td_f12: td_f12 { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp F12>, <&kp F24>; };

        // Tap-Dance per scorciatoie Colemak-DH (1 tap = Ctrl, 2 tap = Meh)
        td_ctrl_a: td_ctrl_a { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp LC(A)>, <&kp LC(LA(LS(A)))>; };
        td_ctrl_w: td_ctrl_w { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp LC(W)>, <&kp LC(LA(LS(W)))>; };
        td_ctrl_f: td_ctrl_f { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp LC(F)>, <&kp LC(LA(LS(F)))>; };
        td_ctrl_s: td_ctrl_s { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <200>; bindings = <&kp LC(S)>, <&kp LC(LA(LS(S)))>; };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <100>;
        };

        usi_quote_dquote: usi_quote_dquote {
            compatible = "zmk,behavior-mod-morph";
            label = "USI_QUOTE_DQUOTE";
            bindings = <&usi_quote>, <&usi_dquote>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_fnc_sys {
            bindings = <&mo FUNCTION_SYSTEM>;
            key-positions = <42 47>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_shortcuts_meh {
            bindings = <&mo SHORTCUTS_MEH>;
            key-positions = <42 43>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_shortcuts_f {
            bindings = <&mo SHORTCUTS_F>;
            key-positions = <43 44>;
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Colemak-DH con Home Row Mods GACS */
        COLEMAK_DH {
            display-name = "CLMK DH";
            bindings = <
&kp ESC         &kp Q       &kp W       &kp F              &kp P                &kp B                                                               &kp UP               &kp J    &kp L              &kp U              &kp Y       &kp SEMI     &kp BACKSPACE
&kp TAB         &hm LGUI A  &hm LALT R  &hm LCTRL S        &hm LSHFT T          &kp G                                                       &kp LEFT  &kp RET   &kp RIGHT  &kp M    &hm RSHFT N        &hm RCTRL E        &hm RALT I  &hm RGUI O   &usi_quote_dquote
&td_shift_caps  &kp Z       &kp X       &kp C              &kp D                &kp V          &kp C_PLAY_PAUSE                             &kp DOWN             &kp K    &kp H              &kp COMMA          &kp DOT     &kp SLASH    &td_shift_caps
                                        &lt NUMPAD_LH ESC  &lt NAV TAB          &lt SHORTCUTS_F SPACE                                                            &lt SYMBOLS RET     &lt ACCENTS BACKSPACE  &lt MEDIA_SYS DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        /* Layer 1: Simboli (Underscore sotto al trattino, < e > affiancati) */
        SYMBOLS {
            display-name = "SYMBOLS";
            bindings = <
&trans  &kp GRAVE  &kp LBRC  &kp RBRC  &kp DLLR  &kp PRCNT                                      &trans          &kp CARET  &kp AMPS       &kp ASTRK  &kp TILDE  &kp BSLH   &trans
&trans  &kp HASH   &kp LPAR  &kp RPAR  &kp EQUAL &kp PLUS                               &trans  &trans  &trans  &kp MINUS  &kp DQT        &kp SQT    &kp COLON  &kp PIPE   &trans
&trans  &kp EXCL   &kp LBKT  &kp RBKT  &kp LT    &kp GT     &trans                              &trans          &kp UNDER  &kp AT         &kp QMARK  &kp SLASH  &trans     &trans
                             &trans    &trans    &trans                                                             &trans     &trans         &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 2: Numpad completo su colonne 0-5 (Roller a trans, Enter a Col 5) */
        NUMPAD_LH {
            display-name = "NUMPAD";
            bindings = <
&kp EQUAL  &kp SLASH  &kp N7  &kp N8  &kp N9  &kp ASTRK                                 &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp BSPC   &kp MINUS  &kp N4  &kp N5  &kp N6  &kp PLUS                          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp DOT    &kp N0     &kp N1  &kp N2  &kp N3  &kp RET    &trans                         &trans          &trans  &trans  &trans  &trans  &trans  &trans
                      &trans  &trans  &trans                                            &trans          &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 3: Navigazione cursore & Workspace */
        NAV {
            display-name = "NAV";
            bindings = <
&trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)                                   &trans          &kp PG_UP  &kp HOME        &kp UP     &kp END    &kp PSCRN  &kp DEL
&trans  &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &kp LG(Q)                            &trans  &trans  &trans  &kp PG_DN  &kp LEFT        &kp DOWN   &kp RIGHT  &kp INS    &trans
&trans  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans                           &trans          &kp LC(Z)  &kp LC(X)       &kp LC(C)  &kp LC(V)  &kp LC(Y)  &trans
                                &trans      &trans      &trans                                                       &trans     &trans          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 4: Vocali Accentuata Italiane su layout Colemak-DH */
        ACCENTS {
            display-name = "ACCENTS";
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &usi_u_grv  &trans      &trans  &trans
&trans  &usi_a_grv  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &usi_e_grv  &usi_i_grv  &usi_o_grv  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &usi_e_acu  &trans      &trans  &trans
                            &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 5: Function Keys F1-F24 (Tap-Dance) e scorciatoie Ctrl a 1 mano */
        SHORTCUTS_F {
            display-name = "LSHTCTS";
            bindings = <
&td_f1     &td_f2     &td_f3     &td_f4     &td_f5     &td_f6                                &none         &none  &none  &none  &none  &none  &none
&td_f7     &td_f8     &td_f9     &td_f10    &td_f11    &td_f12                        &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp LC(Y)  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(D)  &kp LC(V)  &kp C_PLAY_PAUSE           &none         &none  &none  &none  &none  &none  &none
                                 &trans     &trans     &trans                                              &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        /* Layer 6: Meh Modifiers (Ctrl+Alt+Shift) allineati su Colemak-DH */
        SHORTCUTS_MEH {
            display-name = "LSH MEH";
            bindings = <
&trans     &kp LC(LA(LS(Q)))  &td_ctrl_w         &td_ctrl_f         &kp LC(LA(LS(P)))  &kp LC(LA(LS(B)))                               &none         &none  &none  &none  &none  &none  &none
&trans     &td_ctrl_a         &kp LC(LA(LS(R)))  &td_ctrl_s         &kp LC(LA(LS(T)))  &kp LC(LA(LS(G)))                        &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp LC(Y)  &kp LC(Z)          &kp LC(X)          &kp LC(C)          &kp LC(D)          &kp LC(V)          &kp C_PLAY_PAUSE           &none         &none  &none  &none  &none  &none  &none
                                                 &trans             &trans             &trans                                              &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        /* Layer 7: Gaming Standard WASD */
        GAMING {
            display-name = "GAMING";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E               &kp R      &kp T                          &none               &none  &none  &none  &none  &none  &none
&kp TAB    &kp A  &kp S  &kp D               &kp F      &kp G                  &none   &to DEFAULT  &none  &none  &none  &none  &none  &none  &none
&kp LSHFT  &kp Z  &kp X  &kp C               &kp V      &kp B      &kp SLASH           &none               &none  &none  &none  &none  &none  &none
                         &mo GAMING_NUMBERS  &kp LCTRL  &kp SPACE                                          &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp DOT COMMA>;
        };

        /* Layer 8: Gaming Numeri Dedicati */
        GAMING_NUMBERS {
            display-name = "GAMINGN";
            bindings = <
&trans  &kp N1  &trans  &kp N2  &kp N3  &kp N4                      &none         &none  &none  &none  &none  &none  &none
&trans  &trans  &trans  &trans  &kp N5  &kp N6               &none  &none  &none  &none  &none  &none  &none  &none  &none
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &trans           &none         &none  &none  &none  &none  &none  &none
                        &trans  &trans  &trans                                    &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp DOT COMMA>;
        };

        /* Layer 9: Controllo Media, Volume e Luminosità */
        MEDIA_SYS {
            display-name = "MEDIA";
            bindings = <
&trans  &kp C_BRI_UP  &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans                            &trans          &trans        &trans        &trans        &trans  &trans  &trans
&trans  &kp C_BRI_DN  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans                    &trans  &trans  &trans  &kp C_AL_CALC &kp C_BRI_DN  &kp C_BRI_UP  &trans  &trans  &trans
&trans  &trans        &trans      &trans        &trans        &trans  &trans                    &trans          &trans        &trans        &trans        &trans  &trans  &trans
                                  &trans        &trans        &trans                                            &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 10: Hardware, Bluetooth, Profili e Reset (Solo Combo Esterna) */
        FUNCTION_SYSTEM {
            display-name = "FNC SYS";
            bindings = <
&trans  &none  &none  &none  &none  &none                                 &studio_unlock                    &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &trans
&trans  &none  &none  &none  &none  &none                  &out OUT_USB  &sys_reset        &out OUT_BLE    &rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(0,0,100)
&trans  &none  &none  &none  &none  &none  &to GAMING                  &ext_power EP_TOG                   &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &none            &trans
                      &none  &none  &none                                                                    &trans           &trans           &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
