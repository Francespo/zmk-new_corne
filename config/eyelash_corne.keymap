#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    macros {
        mac_a_grv: mac_a_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp A>;
        };

        mac_e_grv: mac_e_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp E>;
        };

        mac_e_acu: mac_e_acu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp E>;
        };

        mac_i_grv: mac_i_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp I>;
        };

        mac_o_grv: mac_o_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp O>;
        };

        mac_u_grv: mac_u_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp U>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <100>;
        };

        excl_qmark: excl_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCL_QMARK";
            bindings = <&kp EXCLAMATION>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        bckspc_del: bckspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BCKSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        undscr_mns: undscr_mns {
            compatible = "zmk,behavior-mod-morph";
            label = "UNDSCR_MNS";
            bindings = <&kp UNDERSCORE>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        COLEMAK-DH {
            display-name = "CLMK DH";
            bindings = <
&kp ESC    &kp Q       &kp W       &kp F        &kp P        &kp B                                    &kp UP               &kp J    &kp L        &kp U        &kp Y       &kp SEMI     &kp BACKSPACE
&kp TAB    &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G                          &kp LEFT  &kp RET   &kp RIGHT  &kp M    &hm RSHFT N  &hm RCTRL E  &hm RALT I  &hm RGUI O   &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp D        &kp V      &kp C_PLAY_PAUSE              &kp DOWN             &kp K    &kp H        &kp COMMA    &kp DOT     &excl_qmark  &kp LSHFT
                                   &mo 2        &mo 3        &kp SPACE                                                     &kp RET  &mo 1        &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        VOWEL_ACCENTS {
            display-name = "ACNT";
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &mac_u_grv  &trans      &trans      &trans
&trans  &mac_a_grv  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &mac_e_grv  &mac_i_grv  &mac_o_grv  &trans
&trans  &trans      &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &mac_e_acu  &trans      &trans      &trans
                            &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        NUMPAD_NAVIGATION {
            display-name = "NPD NAV";
            bindings = <
&trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                            &mmv MOVE_UP                     &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0  &trans
&trans  &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp INSERT       &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW     &kp RIGHT_ARROW  &kp PRINTSCREEN
&trans  &none            &none            &none            &none            &none            &trans                    &mmv MOVE_DOWN                   &kp DELETE       &kp HOME         &kp PAGE_DOWN    &kp PAGE_UP      &kp END          &trans
                                          &trans           &trans           &trans                                                                      &trans           &trans           &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        SYMBOLS_NUMBERS {
            display-name = "SYM NUM";
            bindings = <
&trans  &kp NUMBER_1  &kp N2    &kp N3     &kp N4     &kp N5                    &trans          &kp N6         &kp N7         &kp N8     &kp N9    &kp N0     &trans
&trans  &kp LGUI      &kp LALT  &kp LCTRL  &kp LSHFT  &none             &trans  &trans  &trans  &kp SEMICOLON  &undscr_mns    &kp EQUAL  &kp LBKT  &kp RBKT   &kp APOS
&trans  &none         &none     &none      &none      &none   &trans            &trans          &none          &kp BACKSLASH  &kp COMMA  &kp DOT   &kp SLASH  &trans
                                &trans     &trans     &trans                                    &trans         &trans         &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        FUNCTION_SYSTEM {
            display-name = "FNC SYS";
            bindings = <
&trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                            &studio_unlock                   &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &trans
&trans  &kp F6     &kp F7     &kp F8     &kp F9     &kp F10             &out OUT_USB  &sys_reset         &out OUT_BLE  &rgb_ug RGB_TOG  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(0,0,100)
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &to 5                  &ext_power EP_TOG                &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &trans
                              &kp F11    &kp F12    &trans                                                             &trans           &trans           &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        GAMING-QWERTY {
            display-name = "GMG QRT";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R      &kp T                          &none         &none  &none  &none  &none  &none  &none
&kp TAB    &kp A  &kp S  &kp D  &kp F      &kp G                   &none  &to 0  &none  &none  &none  &none  &none  &none  &none
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V      &kp B      &kp SLASH           &none         &none  &none  &none  &none  &none  &none
                         &mo 6  &kp LCTRL  &kp SPACE                                    &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp DOT COMMA>;
        };

        GAMING-NUMBERS {
            display-name = "GMG NUM";
            bindings = <
&trans  &kp N1  &trans  &kp N2  &kp N3  &kp N4                      &none         &none  &none  &none  &none  &none  &none
&trans  &trans  &trans  &trans  &kp N5  &kp N6               &none  &none  &none  &none  &none  &none  &none  &none  &none
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &trans           &none         &none  &none  &none  &none  &none  &none
                        &trans  &trans  &trans                                    &none  &none  &none
            >;
        };
    };
};
